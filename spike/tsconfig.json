{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["esnext"],
    "types": ["node", "react"],
    "outDir": "out-tsc",
    "rootDir": "src"
  },
  "include": ["src/**/*"]
}
