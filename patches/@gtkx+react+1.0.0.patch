# 1.0-WORKAROUND(dialog-component-ref-widen)
#
# @gtkx/react's shared `createDialogComponent` factory (behind the five
# generated Adw dialog JSX wrappers) types its returned component's props
# as `PresentedProps<Adw.Dialog>`, where `Adw.Dialog` resolves against
# WHATEVER `@gtkx/gi` store `@gtkx/react` itself sees — in an npm
# workspace, the hoisted root store, not the per-app store `gtkx codegen`/
# `gtkx build` generates for each app. Every app whose store differs from
# the root's fails codegen typechecking with ref-covariance errors (one
# per dialog type; reproduced on examples/gallery and examples/profile
# with a bare `npx gtkx codegen`). The runtime is fully duck-typed — this
# is a `.d.ts`-only defect.
#
# Fix: make the factory generic with a default, `<P = DialogComponentProps>`
# — each generated store instantiates `P` with its own props type, removing
# the cross-store variance conflict WITHOUT losing typing. This is also the
# exact signature proposed upstream (docs/upstream-gtkx.md).
#
# PLATFORM NOTE: @gtkx/react's installed `dist/adw/dialog.d.ts` differs
# between Linux and macOS for the same published version (the Linux install
# carries the store-bound `PresentedProps` shape this patch targets). The
# patch therefore applies ONLY on Linux — scripts/apply-patches.ts gates
# `patch-package` by platform. macOS never runs `gtkx codegen`, so the
# defect cannot manifest there.
#
# Removal condition: @gtkx/react's `createDialogComponent` stops pinning a
# single `@gtkx/gi` store's `Dialog` in its returned props type (ships the
# generic, or an equivalent store-agnostic shape).

diff --git a/node_modules/@gtkx/react/dist/adw/dialog.d.ts b/node_modules/@gtkx/react/dist/adw/dialog.d.ts
index bbb1c97..b9f6bc0 100644
--- a/node_modules/@gtkx/react/dist/adw/dialog.d.ts
+++ b/node_modules/@gtkx/react/dist/adw/dialog.d.ts
@@ -2,7 +2,7 @@ import type * as Adw from "@gtkx/gi/adw";
 import { type ElementType, type ReactNode } from "react";
 import { type PresentedProps } from "../hooks/use-presented-instance.js";
 type DialogComponentProps = PresentedProps<Adw.Dialog>;
-declare const createDialogComponent: (Component: ElementType) => ((props: DialogComponentProps) => ReactNode);
+declare const createDialogComponent: <P = DialogComponentProps>(Component: ElementType) => ((props: P) => ReactNode);
 /** @internal */
