{
  "name": "reanimated-dnd-example",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "gtkx dev",
    "dev:real": "DND_IMPL=real gtkx dev",
    "build": "gtkx build",
    "start": "node dist/bundle.mjs",
    "build:mirror": "gtkx build && rm -rf dist-mirror && cp -r dist dist-mirror",
    "build:real": "DND_IMPL=real gtkx build && rm -rf dist-real && cp -r dist dist-real",
    "start:mirror": "node dist-mirror/bundle.mjs",
    "start:real": "node dist-real/bundle.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "8.0.0-alpha.40",
    "react": "^19.2.0",
    "react-native-gtkx": "0.4.0-alpha.3",
    "react-native-reanimated-dnd": "2.0.0"
  },
  "devDependencies": {
    "@gtkx/cli": "1.2.2",
    "@gtkx/config": "1.2.2"
  }
}
