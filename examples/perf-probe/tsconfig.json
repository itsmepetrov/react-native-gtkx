{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "react"],
    // The same two rewrites the vite preset applies at build time
    // (packages/react-native-gtkx/src/vite): this is a Linux-only app, so
    // `react-native` is this platform, not the stock RN types. Examples that
    // really do build for three platforms (hn-app, rn-app) extend
    // @react-native/typescript-config instead, deliberately.
    "paths": {
      "react-native": ["../../packages/react-native-gtkx/dist/index.d.ts"],
      "react-native-svg": [
        "../../packages/react-native-gtkx/dist/svg-compat/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "*.ts"]
}
