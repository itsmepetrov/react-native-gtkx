{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "react"],
    // The rewrites the vite preset applies at build time
    // (packages/react-native-gtkx/src/vite), spelled out for tsc: this is a
    // Linux-only app, so `react-native` is this platform, not the stock RN
    // types. Examples that really do build for three platforms (hn-app,
    // rn-app) extend @react-native/typescript-config instead, deliberately.
    //
    // None of `react-native-svg`, `react-native-reanimated`,
    // `react-native-worklets` or `react-native-gesture-handler` is installed
    // in this workspace; the aliases are what make the sections that import
    // them by their real names both build and typecheck.
    //
    // What is NOT in this list is the point of the `upstream-*` sections:
    // `react-native-reanimated-dnd` and `react-native-drawer-layout` are
    // installed for real and resolve to their own published types. Their
    // `.d.ts` files import `SharedValue`, `AnimatedRef` and `GestureType`
    // from packages that ARE mapped here — so upstream's public type surface
    // is checked against this platform's compat types, which is exactly the
    // pairing the running app uses.
    "paths": {
      "react-native": ["../../packages/react-native-gtkx/dist/index.d.ts"],
      "react-native-svg": [
        "../../packages/react-native-gtkx/dist/svg-compat/index.d.ts"
      ],
      "react-native-reanimated": [
        "../../packages/react-native-gtkx/dist/reanimated-compat/index.d.ts"
      ],
      "react-native-worklets": [
        "../../packages/react-native-gtkx/dist/worklets-compat/index.d.ts"
      ],
      "react-native-gesture-handler": [
        "../../packages/react-native-gtkx/dist/gesture-handler-compat/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "*.ts"]
}
