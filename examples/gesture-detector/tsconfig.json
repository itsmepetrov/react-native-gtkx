{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "react"],
    // The rewrites the vite preset applies at build time
    // (packages/react-native-gtkx/src/vite), spelled out for tsc.
    //
    // The last two are the point of this example: neither
    // `react-native-gesture-handler` nor `react-native-reanimated` is
    // installed here, and every source below imports them by their real
    // names — which is the claim under demonstration, that a ported app
    // changes nothing.
    "paths": {
      "react-native": ["../../packages/react-native-gtkx/dist/index.d.ts"],
      "react-native-gesture-handler": [
        "../../packages/react-native-gtkx/dist/gesture-handler-compat/index.d.ts"
      ],
      "react-native-reanimated": [
        "../../packages/react-native-gtkx/dist/reanimated-compat/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "*.ts"]
}
