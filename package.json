{
  "name": "react-native-gtkx-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "website"
  ],
  "scripts": {
    "codegen": "gtkx codegen",
    "typecheck": "tsc -p packages/react-native-gtkx && tsc -p scripts",
    "typecheck:examples": "node scripts/typecheck-examples.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:gtk": "vitest run --project gtk",
    "docs:check": "node scripts/check-docs-coverage.ts",
    "mcp:generate-data": "node scripts/generate-mcp-data.mjs",
    "mcp:check-data": "node scripts/generate-mcp-data.mjs --check",
    "build:dist": "npm run build:dist -w react-native-gtkx",
    "watch:dist": "npm run watch:dist -w react-native-gtkx",
    "check:package": "npm run build:dist && node scripts/check-package.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.0",
    "@gtkx/vitest": "1.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@napi-rs/canvas": "^1.0.3",
    "@react-navigation/native": "8.0.0-alpha.40",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "brace-expansion": "^5.0.9",
    "fast-xml-parser": "^5.7.0"
  }
}
