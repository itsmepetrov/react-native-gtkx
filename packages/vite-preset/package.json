{
  "name": "@react-native-gtkx/vite-preset",
  "version": "0.1.0",
  "description": "Vite preset for react-native-gtkx: aliases react-native and resolves Metro-style platform extensions inside the gtkx CLI",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "vite": "^8.1.4"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.build.config.ts && tsc -p tsconfig.build.json"
  }
}
